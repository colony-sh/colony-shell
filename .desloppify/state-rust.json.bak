    "review::.::holistic::low_level_elegance::lle_debug_repr_in_shell_output": {
      "id": "review::.::holistic::low_level_elegance::lle_debug_repr_in_shell_output",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "statement_to_shell_string falls back to format!(\"{:?}\", expr) for ExprSub and unknown variants, embedding a Rust Debug string in production shell output",
      "detail": {
        "holistic": true,
        "dimension": "low_level_elegance",
        "related_files": [
          "crates/colony-shell/src/shell/execution/serialization.rs"
        ],
        "evidence": [
          "Line 49: 'WordPart::ExprSub(expr) => result.push_str(&format!(\"$[{:?}]\", expr))'",
          "Line 51: '_ => result.push_str(&format!(\"{:?}\", p))' inside DoubleQuoted arm",
          "Line 80: '_ => result.push_str(&format!(\"{:?}\", other))' at top level",
          "Line 275: 'other => format!(\"{:?}\", other)' for unhandled Statement variants",
          "Debug output (e.g., 'ExprSub { ... }') is not valid shell syntax and would cause re-parse failures if used in coproc or serialisation round-trips."
        ],
        "suggestion": "For ExprSub, implement a proper expression-to-string serialiser or at minimum return an empty string or a comment. For the catch-all Statement arm, consider a compile-time assertion that all variants are handled, or return an empty string with a tracing::warn rather than a Debug dump.",
        "reasoning": "",
        "content_hash": "de1909e1"
      },
      "status": "open",
      "note": null,
      "first_seen": "2026-03-12T21:19:33+00:00",
