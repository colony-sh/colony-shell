    "review::.::holistic::abstraction_fitness::shoptoptions_string_dispatch": {
      "id": "review::.::holistic::abstraction_fitness::shoptoptions_string_dispatch",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "ShoptOptions.get() and .set() implement string-keyed dispatch over struct fields that are already typeable by name",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "crates/colony-expand/src/context.rs"
        ],
        "evidence": [
          "ShoptOptions::get(name: &str) -> Option<bool> contains a 25-arm match that maps string literals to struct field reads; the caller already knows the field by name at compile time in almost all call sites",
          "ShoptOptions::set(name: &str, value: bool) -> bool is a parallel 25-arm match for writes; any typo or missing case is a silent None/false rather than a compile error",
          "The only justification for string-keyed access is the shopt builtin which receives runtime strings from user input \u2014 that specific call site could receive the dispatch while all internal callers use direct field access"
        ],
        "suggestion": "Keep the string dispatch methods only for the shopt builtin handler that receives runtime user strings. All internal callers that currently pass a string literal should access the struct fields directly (e.g., context.shopt.extglob instead of context.shopt.get(\"extglob\")). This eliminates the runtime dispatch overhead and makes typos compile errors.",
        "reasoning": "",
        "content_hash": "14611d34"
      },
      "status": "wontfix",
      "note": "String-keyed dispatch is the correct pattern for shell builtins that receive option names from user input",
      "first_seen": "2026-03-12T21:19:33+00:00",
      "last_seen": "2026-03-12T21:19:53+00:00",
      "resolved_at": "2026-03-12T21:22:46+00:00",
      "reopen_count": 0,
      "lang": "rust",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually reviewed the code and determined this is the correct pattern for a POSIX shell option table and I am not gaming the score by resolving without fixing.",
