// Colony Shell Grammar - pest syntax
//
// This pest grammar defines the core syntactic structure of Colony Shell.
// Context-sensitive lexing and expansion handling require custom preprocessing.
//
// See docs/peg-proposal.md for integration strategy.

// ============================================================================
// Program Structure
// ============================================================================

Program = { SOI ~ NL* ~ (Statement ~ (NL | ";")*)* ~ EOI }

Statement = {
    VarDecl
  | FunctionDef
  | ProcDef
  | FuncDef
  | AgentDef
  | TryStatement
  | IfStatement
  | CaseStatement
  | ForStatement
  | WhileStatement
  | UntilStatement
  | MatchStatement
  | ReturnStatement
  | BreakStatement
  | ContinueStatement
  | CommandList
  | BashAssignment
  | Assignment
  | Comment
  | EmptyStatement
}

EmptyStatement = { Terminator }

Terminator = { NEWLINE | ";" }

// ============================================================================
// Commands and Pipelines
// ============================================================================

CommandList = { AndOrList ~ (ListOp ~ AndOrList)* }

AndOrList = { Pipeline ~ (AndOrOp ~ Pipeline)* }

AndOrOp = { "&&" | "||" }

Pipeline = { "!"? ~ PipelineElement ~ (PipeOp ~ PipelineElement)* }

PipelineElement = {
    FunctionDef
  | CompoundCommand
  | ConditionalCommand
  | ArithmeticCommand
  | SimpleCommand
  | Subshell
}

SimpleCommand = {
    (BashAssignment+ ~ CommandWord? ~ CmdSuffix*)
  | (CommandWord ~ CmdSuffix*)
  | (Redirect+)
}

CmdSuffix = {
    Redirect | ArgumentWord
}

// Command name - cannot be a reserved word or start with #
// Uses ReservedWord (with boundary) not ReservedKeyword so "inner" works
// The !"#" ensures comments (#...) aren't parsed as commands
CommandWord = ${
    !ReservedWord ~ !"#" ~ WordPart+
}

// Argument - CAN be a reserved word (echo done should work)
// Also accepts assignment syntax for declare/local builtins
// The !"#" ensures # starts a comment, not an argument
ArgumentWord = {
    BashAssignment | !"#" ~ Word
}

// Bash-style assignment: name=value or name=(array values) or name[index]=value or name+=(array values)
// The left side (name, subscript, =) must be atomic (no whitespace)
BashAssignment = {
    BashAssignmentLHS ~ (AssocArrayLiteral | ArrayLiteral | Word)?
}

// Left-hand side of assignment - atomic to prevent "a = b" from being parsed as assignment
BashAssignmentLHS = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
    ~ ("[" ~ (!("]") ~ ANY)* ~ "]")?
    ~ ("+=" | "=")
}

// Assignment name - can be any identifier including reserved words (bash allows var=x)
AssignmentName = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

// Associative array literal: ([key1]=val1 [key2]=val2)
AssocArrayLiteral = {
    "(" ~ AssocArrayEntry+ ~ ")"
}

AssocArrayEntry = {
    "[" ~ AssocArrayKey ~ "]" ~ "=" ~ AssocArrayValue
}

AssocArrayKey = @{
    (!"]" ~ ANY)+
}

AssocArrayValue = @{
    (!WHITESPACE ~ !")" ~ ANY)*
}

PipeOp = {
    "|&"
  | "|"
  | "->"
  | "=>"
  | "~>"
}

ListOp = {
    "&&"
  | "||"
  | ";"
  | "&"
}

// ============================================================================
// Compound Commands
// ============================================================================

CompoundCommand = {
    BraceGroup
  | IfStatement
  | CaseStatement
  | ForStatement
  | WhileStatement
  | UntilStatement
  | MatchStatement
}

BraceGroup = { "{" ~ NL* ~ (Statement ~ (NL | ";")*)* ~ "}" ~ Redirect* }

Subshell = { "(" ~ CommandList ~ ")" ~ Redirect* }

// ============================================================================
// Bash Extended Commands
// ============================================================================

// [[ expression ]] - Extended conditional command
ConditionalCommand = { "[[" ~ CondExpr ~ "]]" }

// Conditional expression with logical operators
CondExpr = { CondOrExpr }

CondOrExpr = { CondAndExpr ~ ("||" ~ CondAndExpr)* }

CondAndExpr = { CondUnaryExpr ~ ("&&" ~ CondUnaryExpr)* }

CondUnaryExpr = {
    "!" ~ CondUnaryExpr
  | "(" ~ CondExpr ~ ")"
  | CondPrimary
}

// Primary conditional tests
CondPrimary = {
    CondBinaryTest
  | CondUnaryTest
  | CondStringTest
}

// Binary comparisons: str == str, str != str, str =~ regex, str < str, str > str
// Also: -eq -ne -lt -le -gt -ge for integers
CondBinaryTest = { CondOperand ~ CondBinaryOp ~ CondOperand }

CondBinaryOp = {
    "=~"   // Regex match (bash extension)
  | "=="   // String equality (pattern matching)
  | "!="   // String inequality
  | "<"    // String less than
  | ">"    // String greater than
  | "-eq"  // Integer equal
  | "-ne"  // Integer not equal
  | "-lt"  // Integer less than
  | "-le"  // Integer less than or equal
  | "-gt"  // Integer greater than
  | "-ge"  // Integer greater than or equal
  | "-nt"  // File newer than
  | "-ot"  // File older than
  | "-ef"  // Same file (inode)
  | "="    // String equality (POSIX)
}

// Unary tests: -n str, -z str, -f file, -d dir, etc.
CondUnaryTest = { CondUnaryOp ~ CondOperand }

CondUnaryOp = {
    "-n"   // Non-zero length string
  | "-z"   // Zero length string
  | "-f"   // Regular file
  | "-d"   // Directory
  | "-e"   // File exists
  | "-r"   // Readable
  | "-w"   // Writable
  | "-x"   // Executable
  | "-s"   // Non-empty file
  | "-L"   // Symbolic link
  | "-h"   // Symbolic link (synonym)
  | "-p"   // Named pipe
  | "-S"   // Socket
  | "-b"   // Block device
  | "-c"   // Character device
  | "-t"   // Terminal
  | "-O"   // Owned by effective uid
  | "-G"   // Owned by effective gid
  | "-N"   // Modified since last read
  | "-v"   // Variable is set
}

// Simple string test (non-empty)
CondStringTest = { CondOperand }

// Operand in conditional - can be a word (with expansions)
CondOperand = @{
    (!(WHITESPACE | "]]" | "&&" | "||" | "(" | ")" | "!") ~ ANY)+
}

// (( expression )) - Arithmetic command
ArithmeticCommand = { "((" ~ ArithExprInner ~ "))" }

// Arithmetic expression - handle balanced parens
ArithExprInner = @{ ArithExprPart* }
ArithExprPart = @{
    "(" ~ ArithExprInner ~ ")"
  | (!")" ~ !"((" ~ !"))" ~ ANY)
}

// ============================================================================
// Control Flow
// ============================================================================

IfStatement = {
    "if" ~ Condition ~ ";"? ~ "then" ~ IfThenBody
    ~ ("elif" ~ Condition ~ ";"? ~ "then" ~ IfThenBody)*
    ~ ("else" ~ IfElseBody)?
    ~ "fi"
}

IfThenBody = { Statement* ~ &("elif" | "else" | "fi") }
IfElseBody = { Statement* ~ &"fi" }

CaseStatement = {
    "case" ~ CaseValue ~ "in" ~ NL*
    ~ CaseArm*
    ~ NL* ~ "esac"
}

CaseValue = { Word }

CaseArm = {
    NL* ~ CasePattern+ ~ ")" ~ CaseArmBody ~ CaseTerminator ~ NL*
}

CaseArmBody = { CaseArmStatement* }

CaseArmStatement = {
    !(CaseTerminator | "esac") ~ (
      VarDecl
    | FunctionDef
    | TryStatement
    | IfStatement
    | ForStatement
    | WhileStatement
    | UntilStatement
    | MatchStatement
    | ReturnStatement
    | BreakStatement
    | ContinueStatement
    | AndOrList
    | BashAssignment
    | Assignment
    | SimpleCommand
    | Comment
    | EmptyStatement
    )
}

CasePattern = { "|"? ~ (Word | Expression) }

CaseTerminator = {
    ";;&"
  | ";;"
  | ";&"
}

ForStatement = { "for" ~ ForKind ~ ";"? ~ Block ~ Redirect* }

ForKind = {
    Identifier ~ "," ~ Identifier ~ "in" ~ "enumerate" ~ "(" ~ Expression ~ ")"  // enumerate
  | "((" ~ CStyleForInit? ~ ";" ~ CStyleForCond? ~ ";" ~ CStyleForUpdate? ~ "))"  // C-style: for ((init; cond; update))
  | Identifier ~ "in" ~ WordList  // words (must come before Expression)
  | Identifier ~ "in" ~ Expression  // iterate
}

// C-style for loop components - arithmetic expressions captured as raw strings
// These support: assignment (i=0), comparison (i<3), increment (i++, ++i), 
// decrement (i--, --i), compound assignment (i+=1, i-=2, i*=2, i/=2)
CStyleForInit = @{ CStyleArithExpr ~ ("," ~ CStyleArithExpr)* }
CStyleForCond = @{ CStyleArithExpr }
CStyleForUpdate = @{ CStyleArithExpr ~ ("," ~ CStyleArithExpr)* }

// C-style arithmetic expression - captures everything up to ; or ))
// Supports: var=val, var++, ++var, var--, --var, var+=val, var-=val, var*=val, var/=val
// Comparisons: var<val, var<=val, var>val, var>=val, var==val, var!=val
CStyleArithExpr = @{
    (!(";" | "))") ~ !("," ~ CStyleArithExpr) ~ ANY)+
}

// Word list for for loops - must not consume keywords like "do"
WordList = { (!BlockStart ~ Word)+ }

// Keywords that start a block (stop word list parsing)
BlockStart = { ("do" | "then") ~ !(ASCII_ALPHANUMERIC | "_") | "{" }

WhileStatement = { "while" ~ Condition ~ (";" | NL)* ~ Block ~ Redirect* }

UntilStatement = { "until" ~ Condition ~ (";" | NL)* ~ Block ~ Redirect* }

MatchStatement = {
    "match" ~ Expression ~ "{"
    ~ MatchArm*
    ~ "}"
}

MatchArm = {
    MatchPattern ~ ("if" ~ Expression)? ~ "=>" ~ (Block | Expression)
}

MatchPattern = {
    ListPattern
  | DictPattern
  | TuplePattern
  | LiteralPattern
  | BindingPattern
  | WildcardPattern
}

ListPattern = {
    "[" ~ (MatchPattern ~ ("," ~ MatchPattern)*)? ~ ("," ~ ".." ~ Identifier?)? ~ "]"
}

DictPattern = {
    "{" ~ (DictPatternField ~ ("," ~ DictPatternField)*)? ~ ("," ~ "..")? ~ "}"
}

DictPatternField = { Identifier ~ (":" ~ MatchPattern)? }

TuplePattern = { "(" ~ MatchPattern ~ ("," ~ MatchPattern)+ ~ ")" }

// TODO: Re-add RangePattern with proper precedence
// RangePattern = { Expression ~ ".." ~ "="? ~ Expression }

LiteralPattern = { Expression }

BindingPattern = { Identifier }

WildcardPattern = { "_" }

OrPattern = { MatchPattern ~ ("|" ~ MatchPattern)+ }

TryStatement = {
    "try" ~ Block
    ~ ("catch" ~ CatchBlock)?
    ~ ("finally" ~ Block)?
}

CatchBlock = {
    Identifier? ~ (":" ~ Identifier)? ~ Block
}

Condition = { CommandList | Expression }

Block = {
    "{" ~ NL* ~ (Statement ~ (NL | ";")*)* ~ "}"
  | "do" ~ NL* ~ (Statement ~ (NL | ";")*)* ~ "done"
  | "then" ~ NL* ~ (Statement ~ (NL | ";")*)* ~ ("elif" | "else" | "fi")
}

NL = _{ "\n" }

// ============================================================================
// Declarations
// ============================================================================

VarDecl = {
    VarKind ~ Identifier ~ (":" ~ TypeAnnotation)? ~ "=" ~ Expression
}

VarKind = { "var" | "const" | "setvar" }

Assignment = {
    Identifier ~ AssignOp ~ Expression
}

AssignOp = {
    "+="
  | "-="
  | "*="
  | "/="
  | "%="
  | "&="
  | "|="
  | "^="
  | "<<="
  | ">>="
  | "??="
  | "="
}

FunctionDef = {
    ("function" ~ Identifier ~ ("(" ~ ")")? ~ Block)
  | (Identifier ~ "(" ~ ")" ~ Block)
}

ProcDef = {
    "proc" ~ Identifier ~ PipelineTypeAnnot? ~ ProcParams ~ Block
}

ProcParams = {
    "(" ~ (ProcParam ~ ("," ~ ProcParam)*)? ~ ")"
}

ProcParam = {
    Identifier ~ (":" ~ TypeAnnotation)? ~ ("=" ~ Expression)?
}

PipelineTypeAnnot = {
    "[" ~ TypeAnnotation ~ "->" ~ TypeAnnotation ~ "]"
}

FuncDef = {
    "func" ~ Identifier ~ FuncParams ~ ("->" ~ TypeAnnotation)? ~ FuncBody
}

FuncParams = {
    "(" ~ (FuncParam ~ ("," ~ FuncParam)*)? ~ ")"
}

FuncParam = {
    Identifier ~ (":" ~ TypeAnnotation)? ~ ("=" ~ Expression)?
}

FuncBody = {
    Block
  | ("=" ~ Expression)
}

AgentDef = {
    "agent" ~ Identifier ~ "{"
    ~ AgentField*
    ~ "}"
}

AgentField = {
    ("description" ~ ":" ~ StringLiteral)
  | ("version" ~ ":" ~ StringLiteral)
  | ("param" ~ ProcParam)
  | ("tools" ~ ":" ~ StringList)
  | ("mcp_servers" ~ ":" ~ StringList)
  | ("max_tokens" ~ ":" ~ Integer)
  | ("temperature" ~ ":" ~ Float)
  | ("model" ~ ":" ~ StringLiteral)
  | ("context" ~ ":" ~ ContextCaps)
  | ("prompt" ~ ":" ~ AgentPrompt)
  | ("on_start" ~ Block)
  | ("on_tool_call" ~ "(" ~ Identifier ~ "," ~ Identifier ~ ")" ~ Block)
  | ("on_message" ~ "(" ~ Identifier ~ ")" ~ Block)
  | ("on_complete" ~ "(" ~ Identifier ~ ")" ~ Block)
  | ("on_error" ~ "(" ~ Identifier ~ ")" ~ Block)
}

StringList = {
    "[" ~ (StringLiteral ~ ("," ~ StringLiteral)*)? ~ "]"
}

ContextCaps = {
    "{" ~ (ContextCap ~ ("," ~ ContextCap)*)? ~ "}"
}

ContextCap = {
    ("read" ~ ":" ~ Boolean)
  | ("write" ~ ":" ~ Boolean)
  | ("types" ~ ":" ~ StringList)
}

AgentPrompt = {
    StringLiteral
  | ("file" ~ "(" ~ StringLiteral ~ ")")
}

ReturnStatement = { "return" ~ Expression? }

BreakStatement = { "break" ~ Identifier? }

ContinueStatement = { "continue" ~ Identifier? }

// ============================================================================
// Redirections
// ============================================================================

Redirect = {
    FdRedirect | SimpleRedirect
}

FdRedirect = {
    FdRedirectPrefix ~ (Word | Integer)
}

FdRedirectPrefix = @{
    ASCII_DIGIT+ ~ ("<<<" | "<<-" | "<<" | "&>>" | "&>" | ">>" | ">|" | "<>" | "<&" | ">&" | "<" | ">")
}

SimpleRedirect = {
    RedirectOp ~ (Word | Integer)
}

RedirectOp = {
    "<<<"  // here-string
  | "<<-"  // here-doc strip
  | "<<"   // here-doc
  | "&>>"  // append both stdout and stderr (bash extension)
  | "&>"   // redirect both stdout and stderr (bash extension)
  | ">>"   // append
  | ">|"   // clobber
  | "<>"   // read-write
  | "<&"   // dup input
  | ">&"   // dup output
  | "<"    // input
  | ">"    // output
}

// ============================================================================
// Expressions
// ============================================================================

Expression = { TernaryExpr }

TernaryExpr = {
    NullCoalesceExpr ~ ("?" ~ Expression ~ ":" ~ Expression)?
}

NullCoalesceExpr = {
    OrExpr ~ ("??" ~ OrExpr)*
}

OrExpr = {
    AndExpr ~ ("||" ~ AndExpr)*
}

AndExpr = {
    EqualityExpr ~ ("&&" ~ EqualityExpr)*
}

EqualityExpr = {
    ComparisonExpr ~ (EqualityOp ~ ComparisonExpr)*
}

EqualityOp = {
    "=="
  | "!="
  | "=~"
  | "!~"
  | "~~"
}

ComparisonExpr = {
    BitwiseOrExpr ~ (ComparisonOp ~ BitwiseOrExpr)*
}

ComparisonOp = {
    "<="
  | ">="
  | "<"
  | ">"
}

BitwiseOrExpr = {
    BitwiseXorExpr ~ ("|" ~ BitwiseXorExpr)*
}

BitwiseXorExpr = {
    BitwiseAndExpr ~ ("^" ~ BitwiseAndExpr)*
}

BitwiseAndExpr = {
    ShiftExpr ~ ("&" ~ ShiftExpr)*
}

ShiftExpr = {
    AdditiveExpr ~ (ShiftOp ~ AdditiveExpr)*
}

ShiftOp = {
    "<<"
  | ">>"
}

AdditiveExpr = {
    MultiplicativeExpr ~ (AdditiveOp ~ MultiplicativeExpr)*
}

AdditiveOp = {
    "+"
  | "-"
}

MultiplicativeExpr = {
    PowerExpr ~ (MultiplicativeOp ~ PowerExpr)*
}

MultiplicativeOp = {
    "//"
  | "/"
  | "*"
  | "%"
}

PowerExpr = {
    UnaryExpr ~ ("**" ~ UnaryExpr)*
}

UnaryExpr = {
    (UnaryOp ~ UnaryExpr)
  | PostfixExpr
}

UnaryOp = {
    "!"
  | "~"
  | "-"
  | "not"
}

PostfixExpr = {
    PrimaryExpr ~ PostfixOp*
}

PostfixOp = {
    ("[" ~ Expression ~ "]")  // index
  | ("." ~ Identifier)        // field
  | ("(" ~ ArgList ~ ")")     // call
  | "?"                        // optional-chain
  | "!"                        // unwrap
}

ArgList = {
    (Expression ~ ("," ~ Expression)*)?
}

PrimaryExpr = {
    Null
  | Boolean
  | Float
  | Integer
  | StringLiteral
  | ListExpr
  | DictExpr
  | TupleExpr
  | LambdaExpr
  | Identifier
  | ("(" ~ Expression ~ ")")
}

Null = { "null" }

Boolean = { "true" | "false" }

ListExpr = {
    "[" ~ (Expression ~ ("," ~ Expression)* ~ ","?)? ~ "]"
}

DictExpr = {
    "{" ~ (DictEntry ~ ("," ~ DictEntry)* ~ ","?)? ~ "}"
}

DictEntry = {
    (Identifier | StringLiteral | ("[" ~ Expression ~ "]"))
    ~ ":" ~ Expression
}

TupleExpr = {
    "(" ~ Expression ~ "," ~ (Expression ~ ("," ~ Expression)*)? ~ ")"
}

// TODO: Re-add RangeExpr at proper precedence level (between comparison and bitwise?)
// RangeExpr = {
//     PostfixExpr ~ ".." ~ "="? ~ PostfixExpr ~ (".." ~ PostfixExpr)?
// }

LambdaExpr = {
    "|" ~ (Identifier ~ ("," ~ Identifier)*)? ~ "|"
    ~ (Block | Expression)
}

// ============================================================================
// Type Annotations
// ============================================================================

TypeAnnotation = {
    FunctionType
  | UnionType
  | OptionalType
  | TupleType
  | GenericType
  | SimpleType
}

FunctionType = {
    "(" ~ (TypeAnnotation ~ ("," ~ TypeAnnotation)*)? ~ ")"
    ~ "->" ~ TypeAnnotation
}

UnionType = {
    SimpleType ~ ("|" ~ SimpleType)+
}

OptionalType = {
    SimpleType ~ "?"
}

TupleType = {
    "(" ~ TypeAnnotation ~ ("," ~ TypeAnnotation)+ ~ ")"
}

GenericType = {
    Identifier ~ "[" ~ (TypeAnnotation ~ ("," ~ TypeAnnotation)*)? ~ "]"
}

SimpleType = {
    "Null"
  | "Bool"
  | "Int"
  | "Float"
  | "Str"
  | "Bytes"
  | "Any"
  | "Never"
  | Identifier
}

// ============================================================================
// Words and Expansions (Preprocessing Required)
// ============================================================================

// Word in command context - can contain multiple parts
// Example: "hello$world" or "$a:$b" or "pre${var}post"
// MUST use ${...} (compound_atomic) so WordParts stick together without whitespace
Word = ${
    WordPart+
}

WordPart = _{
    QuotedString
  | DollarExpansion
  | BacktickCommandSub
  | TildeExpansion
  | BraceExpansion
  | UnquotedEscape
  | Bareword
}

// Backtick command substitution: `cmd` - captured as raw string, parsed during expansion
// Must handle escaped backticks within the content (\`)
BacktickCommandSub = @{
    "`" ~ BacktickContent ~ "`"
}

BacktickContent = @{
    (!"\\`" ~ !"`" ~ ANY | "\\`")*
}

// Tilde expansion: ~ or ~user or ~+ or ~-
// Only at start of word, so we capture it as a WordPart
// Examples: ~ ~/foo ~root ~+ ~- ~user/path
TildeExpansion = @{
    "~" ~ TildeUser?
}

TildeUser = @{
    "+" | "-" | (!(WHITESPACE | "/" | ":" | "\"" | "'" | SpecialChar) ~ ANY)*
}

// Escape sequences in unquoted context: \$ becomes $ for expansion, \x becomes x for other chars
UnquotedEscape = @{
    "\\" ~ ANY
}

// Brace expansion: {a,b,c} or {1..5} - expanded at expansion time, not parsed structurally
BraceExpansion = @{
    "{" ~ BraceContent ~ "}"
}

BraceContent = @{
    (!"}" ~ ANY)+
}

// Array literal: (word1 word2 word3)
ArrayLiteral = {
    "(" ~ Word* ~ ")"
}

// Bareword - plain text without quotes or expansions  
Bareword = {
    BarewordChars
}

BarewordChars = @{
    (!WHITESPACE ~ !SpecialChar ~ !"$" ~ !"\"" ~ !"'" ~ !"`" ~ !"\\" ~ ANY)+
}

SpecialChar = {
    "|" | "&" | ";" | "<" | ">" | "(" | ")" | "{" | "}"
  | "\n" | "\r" | "\t"
}

// Dollar expansions - handled directly by pest
// For command substitution and arithmetic, we capture the string and parse it during expansion
DollarExpansion = {
    DollarArithRaw                       // $((expr)) captured as string
  | DollarCommandSubRaw                  // $(cmd)   captured as string
  | ("$[" ~ Expression ~ "]")            // $[expr]  - parsed inline (Colony)
  | ("${" ~ VariableRef ~ "}")           // ${var}   - parsed inline
  | ("$" ~ PositionalParam)              // $1, $@, $#, etc. - positional parameters
  | ("$" ~ VariableName)                 // $var     - parsed inline (allows reserved words)
}

// Variable name - can be any identifier including reserved words (bash allows $var)
VariableName = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

// Positional parameters and special variables
PositionalParam = @{
    ASCII_DIGIT+                         // $1, $2, $10, etc.
  | "@"                                  // $@ - all parameters
  | "*"                                  // $* - all parameters as single word
  | "#"                                  // $# - parameter count
  | "?"                                  // $? - last exit status
  | "$"                                  // $$ - process ID
  | "!"                                  // $! - last background job PID
  | "0"                                  // $0 - shell name
  | "-"                                  // $- - shell flags
}

// Arithmetic expansion as raw string - parsed and evaluated during expansion
// Must match $(( before $( to avoid ambiguity
// Simple approach: match $(( plus any non-whitespace chars
DollarArithRaw = @{
    "$((" ~ (!"))" ~ ANY)* ~ "))"
}

// Command substitution with balanced parentheses support for nesting
// $(cmd) where cmd can contain nested $(...) or plain (...)
// Uses compound_atomic ($) to capture entire content as single string
DollarCommandSubRaw = ${
    "$(" ~ !"(" ~ DollarCommandSubInner ~ ")"
}

// Inner content of $(...) - NOT atomic, allows recursion
DollarCommandSubInner = {
    DollarCommandSubPart*
}

// Parts inside $(...) - handles balanced parentheses for nesting
DollarCommandSubPart = {
    DollarCommandSubRaw                              // nested $(...)
  | DollarCommandSubParens                           // other balanced parens like (subshell)
  | DollarCommandSubQuoted                           // quoted strings (may contain parens)
  | DollarCommandSubChar                             // regular chars
}

// Balanced parentheses (not $())
DollarCommandSubParens = {
    "(" ~ DollarCommandSubInner ~ ")"
}

// Quoted strings inside command substitution
DollarCommandSubQuoted = @{
    ("\"" ~ (!"\"" ~ ANY | "\\\"")* ~ "\"")          // double-quoted
  | ("'" ~ (!"'" ~ ANY)* ~ "'")                      // single-quoted
}

// Single character that's not special
DollarCommandSubChar = @{
    !(")" | "(" | "\"" | "'" | "$") ~ ANY            // regular chars
  | "$" ~ !"("                                       // $ not followed by ( (like $var)
}

VariableRef = {
    VarPrefix? ~ Identifier ~ ArraySubscript? ~ VarModifier?
}

// Prefix modifiers that come before identifier
VarPrefix = {
    "#"   // Length
  | "!"   // Indices (for arrays)
}

// Array subscript: [index], [@], [*], [$var]
ArraySubscript = {
    "[" ~ (ArraySpecial | DollarExpansion | Expression) ~ "]"
}

// Special array subscripts
ArraySpecial = {
    "@"   // All elements as separate words
  | "*"   // All elements as single word
}

VarModifier = {
    (":" ~ SliceOffset ~ (":" ~ SliceLength)?)  // slice ${arr[@]:offset:length} - MUST be first to avoid conflicts with :- etc
  | (":-" ~ Word?)                       // default (if unset or null)
  | ("-" ~ Word?)                        // default (if unset only)
  | (":=" ~ Word?)                       // assign (if unset or null)
  | ("=" ~ Word?)                        // assign (if unset only)
  | (":?" ~ Word?)                       // error (if unset or null)
  | ("?" ~ Word?)                        // error (if unset only)
  | (":+" ~ Word?)                       // alternate (if set and not null)
  | ("+" ~ Word?)                        // alternate (if set)
  | ("##" ~ Word)                        // strip prefix greedy
  | ("#" ~ Word)                         // strip prefix
  | ("%%" ~ Word)                        // strip suffix greedy
  | ("%" ~ Word)                         // strip suffix
  | ("//" ~ Word ~ "/" ~ Word)           // replace all
  | ("/" ~ Word ~ "/" ~ Word)            // replace first
  | "^^"                                 // uppercase all
  | "^"                                  // uppercase first
  | ",,"                                 // lowercase all
  | ","                                  // lowercase first
  | "#"                                  // length (scalar or array)
  | "!"                                  // array indices
  | ("[" ~ Slice ~ "]")                  // slice (old syntax)
}

// Slice offset (simple integer or expression)
SliceOffset = @{ "-"? ~ ASCII_DIGIT+ }

// Slice length (simple integer)
SliceLength = @{ ASCII_DIGIT+ }

Slice = {
    Expression ~ (":" ~ Expression)?
}

QuotedString = {
    SingleQuoted
  | DoubleQuoted
  | RawString
  | TripleQuoted
}

// ============================================================================
// Literals
// ============================================================================

Integer = @{
    HexInt
  | OctInt
  | BinInt
  | DecInt
}

DecInt = @{ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }

HexInt = @{ "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT ~ (ASCII_HEX_DIGIT | "_")* }

OctInt = @{ "0" ~ ("o" | "O") ~ ASCII_OCT_DIGIT ~ (ASCII_OCT_DIGIT | "_")* }

BinInt = @{ "0" ~ ("b" | "B") ~ ASCII_BIN_DIGIT ~ (ASCII_BIN_DIGIT | "_")* }

Float = @{
    (DecInt ~ "." ~ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* ~ Exponent?)
  | (DecInt ~ Exponent)
}

Exponent = @{ ("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+ }

StringLiteral = {
    DoubleQuoted
  | SingleQuoted
  | RawString
  | TripleQuoted
}

// Double-quoted strings with interpolation
DoubleQuoted = ${
    "\"" ~ DoubleQuotedContent* ~ "\""
}

DoubleQuotedContent = {
    DollarExpansion
  | BacktickCommandSub
  | EscapeSequence
  | DoubleQuotedChar
}

DoubleQuotedChar = {
    !("\"" | "$" | "`" | "\\") ~ ANY
}

// POSIX: Inside double quotes, backslash only removes special meaning from: $ ` " \ newline
// For any other character, the backslash is preserved literally (e.g., "\a" -> \a)
// We capture the entire sequence and handle interpretation in the builder
EscapeSequence = @{
    "\\" ~ ANY
}

// Single-quoted strings are literal (no interpolation)
SingleQuoted = @{ "'" ~ (!"'" ~ ANY)* ~ "'" }

RawString = @{
    "r" ~ ("'" ~ (!"'" ~ ANY)* ~ "'")
  | "r" ~ ("\"" ~ (!"\"" ~ ANY)* ~ "\"")
}

TripleQuoted = @{
    ("'''" ~ (!"'''" ~ ANY)* ~ "'''")
  | ("\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\"")
}

Literal = @{ (ASCII_ALPHANUMERIC | "_" | "-" | "." | "/" | ":")+ }

Identifier = @{
    !ReservedWord ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

ReservedWord = ${
    ReservedKeyword ~ &WordBoundary
}

ReservedKeyword = @{
    "if" | "then" | "else" | "elif" | "fi"
  | "case" | "esac" | "in"
  | "for" | "while" | "until" | "done" | "do"
  | "function"
  | "var" | "const" | "setvar"
  | "try" | "catch" | "finally"
  | "match" | "return" | "break" | "continue"
}

WordBoundary = { !ASCII_ALPHANUMERIC ~ !"_" | EOI }

Comment = {
    BlockComment
  | LineComment
}

LineComment = @{ "#" ~ (!NEWLINE ~ ANY)* ~ NEWLINE? }

BlockComment = @{ "/#" ~ (!"#/" ~ ANY)* ~ "#/" }

// ============================================================================
// Whitespace (pest built-in handling)
// ============================================================================

WHITESPACE = _{ " " | "\t" | "\r" }

NEWLINE = _{ "\n" }
