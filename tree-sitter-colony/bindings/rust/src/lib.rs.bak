//! Tree-sitter grammar for Colony Shell (rust-sitter)
//!
//! This crate provides a pure Rust Tree-sitter parser for Colony Shell syntax.
//! Generated using rust-sitter - no C code, no FFI, just Rust.
//!
//! Used for editor features like syntax highlighting, folding, and navigation.
//! For execution, use colony-parser (Pest or hand-written).

// The parser code will be generated here by rust-sitter
// Run: rust-sitter generate --rust-package-info Cargo.toml

/// Get the Tree-sitter language
pub fn language() -> tree_sitter::Language {
    // This will be generated by rust-sitter
    todo!("Run: rust-sitter generate --rust-package-info Cargo.toml")
}

/// Content of the highlights query
pub const HIGHLIGHTS_QUERY: &str = include_str!("../../../queries/highlights.scm");

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    #[ignore] // Until rust-sitter generates the parser
    fn test_can_load_grammar() {
        let _language = language();
    }

    #[test]
    #[ignore] // Until rust-sitter generates the parser
    fn test_parse_simple_command() {
        use tree_sitter::Parser;

        let mut parser = Parser::new();
        parser.set_language(language()).unwrap();

        let source = "echo hello world";
        let tree = parser.parse(source, None).unwrap();
        let root = tree.root_node();

        assert_eq!(root.kind(), "program");
        assert!(root.child_count() > 0);
    }

    #[test]
    #[ignore] // Until rust-sitter generates the parser
    fn test_parse_pipeline() {
        use tree_sitter::Parser;

        let mut parser = Parser::new();
        parser.set_language(language()).unwrap();

        let source = "echo foo | grep f";
        let tree = parser.parse(source, None).unwrap();
        let root = tree.root_node();

        assert_eq!(root.kind(), "program");
    }

    #[test]
    #[ignore] // Until rust-sitter generates the parser
    fn test_incremental_parse() {
        use tree_sitter::Parser;

        let mut parser = Parser::new();
        parser.set_language(language()).unwrap();

        // Initial parse
        let source1 = "echo hello";
        let tree1 = parser.parse(source1, None).unwrap();

        // Edit: change "hello" to "world"
        let source2 = "echo world";
        let tree2 = parser.parse(source2, Some(&tree1)).unwrap();

        // Both should successfully parse
        assert_eq!(tree1.root_node().kind(), "program");
        assert_eq!(tree2.root_node().kind(), "program");
    }
}
