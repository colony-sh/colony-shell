{
  "name": "tree-sitter-colony",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for Colony Shell",
  "main": "bindings/node",
  "keywords": [
    "tree-sitter",
    "parser",
    "shell",
    "colony"
  ],
  "author": "Colony Contributors",
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "nan": "^2.17.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.20.8"
  },
  "tree-sitter": [
    {
      "scope": "source.colony",
      "file-types": [
        "sh",
        "colony"
      ],
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ]
}
